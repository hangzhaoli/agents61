EDGAR_USER_AGENT=Agents61/1.0 (https://agents61.com; research@agents61.com)

# Optional. Server-side model input only — never shown as a live quote.
# Get a free key at https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Finnhub — free real-time US quotes, 60 calls/min, email-only signup (no
# business entity needed). Homepage tape + desk boards try Finnhub first.
# Signup: https://finnhub.io/register → instant API key.
# FINNHUB_API_KEY=

# Alpaca market data — free IEX real-time, but requires a US business entity.
# Optional; the chain works without it. https://alpaca.markets
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=

# Shared news layer for reports — one web scan per subject, cached 12h,
# digested by DeepSeek Flash and injected into every seat + the clerk.
# Tavily free Researcher tier: 1,000 basic searches/mo, no credit card.
# Signup: https://app.tavily.com → API key. Without it reports run as before.
# TAVILY_API_KEY=

# USDT annual backup (TRC-20). Put YOUR wallet address only — never a seed phrase.
# Funds go to this address; you withdraw from that wallet yourself.
# USDT_CHAIN=trc20
# USDT_ADDRESS=
# USDT_SIGNING_SECRET=
# Optional TronGrid key if public rate limits hit:
# TRONGRID_API_KEY=

# Lemon Squeezy (card + PayPal). Apply the store, then paste IDs. Test mode until approved.
# Webhook: https://agents61.com/api/billing/lemonsqueezy/webhook
# Events: subscription_created, subscription_updated, subscription_cancelled,
#         subscription_expired, order_created, order_refunded
# Product copy: research simulation / educational tool — not investment advice.
# LEMON_SQUEEZY_API_KEY=
# LEMON_SQUEEZY_STORE_ID=
# LEMON_SQUEEZY_WEBHOOK_SECRET=
# LEMON_SQUEEZY_TEST_MODE=true
# LEMON_SQUEEZY_REDIRECT_URL=https://agents61.com/checkout/lemonsqueezy
# LEMON_SQUEEZY_VARIANT_ANALYST_MONTHLY=
# LEMON_SQUEEZY_VARIANT_ANALYST_YEARLY=
# LEMON_SQUEEZY_VARIANT_ASSOCIATE_MONTHLY=
# LEMON_SQUEEZY_VARIANT_ASSOCIATE_YEARLY=
# LEMON_SQUEEZY_VARIANT_PRINCIPAL_MONTHLY=
# LEMON_SQUEEZY_VARIANT_PRINCIPAL_YEARLY=
# LEMON_SQUEEZY_VARIANT_COMMITTEE_MONTHLY=
# LEMON_SQUEEZY_VARIANT_COMMITTEE_YEARLY=
# LEMON_SQUEEZY_VARIANT_PARTNERS_MONTHLY=
# LEMON_SQUEEZY_VARIANT_PARTNERS_YEARLY=
# LEMON_SQUEEZY_VARIANT_FOUNDING=

# Waffo Pancake (cards + Apple Pay + Google Pay, Merchant of Record).
# Signup: https://pancake.waffo.ai → API & Development. KYB is approved;
# products are published to production. Re-run `node scripts/waffo-setup.mjs`
# only if you need a new catalog — it creates NEW product IDs.
# Webhook: https://agents61.com/api/billing/waffo/webhook
# Production store (Agents61):
# WAFFO_MERCHANT_ID=MER_0IExipSffGUHuMWwuMHFqu
# WAFFO_STORE_ID=STO_0dhg8cTKnxVY3YREU9Jt62
# WAFFO_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#   …or base64 the whole PEM: WAFFO_PRIVATE_KEY_BASE64=
# WAFFO_SUCCESS_URL=https://agents61.com/checkout/waffo
# KYB domain verify (Pancake → 生成验证指引). Same value drives homepage
# <meta name="waffo-verify"> and https://agents61.com/.well-known/waffo-verify.txt
# WAFFO_DOMAIN_VERIFY=
# Leave unset in production so test-card webhooks cannot unlock a desk.
# WAFFO_TEST_UNLOCK=false
# WAFFO_PRODUCT_ANALYST_MONTHLY=PROD_7NKEzIpaQJVtX262gPfYdn
# WAFFO_PRODUCT_ANALYST_YEARLY=PROD_4xuU0g86vNnYoJuABs3QTF
# WAFFO_PRODUCT_ASSOCIATE_MONTHLY=PROD_3x41Q4Ng7SZCZ04EMPr0Kn
# WAFFO_PRODUCT_ASSOCIATE_YEARLY=PROD_63QnqLjuuBaiM9oaCzRtAJ
# WAFFO_PRODUCT_PRINCIPAL_MONTHLY=PROD_6iZkdloA0MSmp0qRBvXLnB
# WAFFO_PRODUCT_PRINCIPAL_YEARLY=PROD_3qU2DUrto7bwkH5oT3Qkec
# WAFFO_PRODUCT_COMMITTEE_MONTHLY=PROD_40Vp12it8VLA4VfDkjVhbn
# WAFFO_PRODUCT_COMMITTEE_YEARLY=PROD_525c1sopaLmFhrrDC5Lq2h
# WAFFO_PRODUCT_PARTNERS_MONTHLY=PROD_0vC5jfBs1oWLH8aAwOoPOg
# WAFFO_PRODUCT_PARTNERS_YEARLY=PROD_2uYLYsxPPaRrrmnjQpoZPm
# WAFFO_PRODUCT_FOUNDING=PROD_5WpPqtnCaalhOMx9C7f4Is
# One-time token-extra packs (create with `node scripts/waffo-extras.mjs`):
# WAFFO_PRODUCT_PACK_25=PROD_2kcXOCXpHw3hcvlV29Ln0Q
# WAFFO_PRODUCT_PACK_80=PROD_2RcwsclgddjaociiaZjgyj

# NOWPayments (crypto invoice / optional wallet re-bill). Custody by default.
# Dashboard: API key + IPN secret. Webhook: https://agents61.com/api/billing/nowpayments/ipn
# Optional: create subscription plans and paste IDs for auto re-bill; otherwise each cycle is a new invoice.
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_PAY_CURRENCY=usdttrc20
# NOWPAYMENTS_IPN_CALLBACK_URL=https://agents61.com/api/billing/nowpayments/ipn

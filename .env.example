# NOWPAYMENTS_PLAN_PARTNERS_MONTHLY=
# NOWPAYMENTS_PLAN_PARTNERS_YEARLY=
# NOWPAYMENTS_PLAN_FOUNDING=

# DeepSeek V4 (live isolated briefs on /api/desk/convene). Server-side only.
# Create a key at https://platform.deepseek.com — never commit it.
# Legacy names deepseek-chat / deepseek-reasoner are retired; the app uses
# deepseek-v4-flash (cards) and deepseek-v4-pro (debate + verdict, thinking on).
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Supabase — desk watchlist + strategy vault cloud sync (server-side service role only).
# Browser never talks to Supabase directly; sync goes through /api/sync/* routes.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Email/password + Google OAuth. Add this to Supabase Auth → URL Configuration
# redirect allow list: https://agents61.com/auth/callback
# Google provider must be enabled (Client ID + secret from Google Cloud).

# Optional crypto / on-chain research feeds (model input, never a live quote product):
# COINGECKO_API_KEY=
# COINGECKO_API_URL=https://api.coingecko.com/api/v3
# GLASSNODE_API_KEY=
# DUNE_API_KEY=
# DEFILLAMA_ENABLED=false

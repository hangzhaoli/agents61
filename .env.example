# NOWPAYMENTS_PLAN_ANALYST_MONTHLY=
# NOWPAYMENTS_PLAN_ANALYST_YEARLY=
# NOWPAYMENTS_PLAN_ASSOCIATE_MONTHLY=
# NOWPAYMENTS_PLAN_ASSOCIATE_YEARLY=
# NOWPAYMENTS_PLAN_PRINCIPAL_MONTHLY=
# NOWPAYMENTS_PLAN_PRINCIPAL_YEARLY=
# NOWPAYMENTS_PLAN_COMMITTEE_MONTHLY=
